# Viata Luxe — Environment (copy to .env, never commit .env)
APP_ENV=production
APP_DEBUG=false
BASE_URL=https://dzongamulti-investment.co.za/final%20website

DB_HOST=localhost
DB_PORT=3306
DB_NAME=<cpanel_mysql_database>
DB_USER=<cpanel_mysql_user>
DB_PASS=<cpanel_mysql_password>
DB_CHARSET=utf8mb4

# Optional: CDN base for assets (empty = same origin)
ASSET_URL=

# Session
ADMIN_TIMEOUT=1800
